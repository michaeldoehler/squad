# Scalar expressions, NULL logic and type coercion.

query IIIII
SELECT 1 + 2 * 3, (1 + 2) * 3, 7 / 2, -7 / 2, 7 % 3
----
7 9 3 -3 1

query RRR
SELECT 7 / 2.0, 1.5 + 1, 2 * 0.25
----
3.500 2.500 0.500

query R
SELECT 1::float8 / 3
----
0.333

query TTT
SELECT 1 = 1, 1 <> 1, 2 > 1
----
t f t

query TTTT
SELECT NULL = NULL, NULL <> 1, NULL IS NULL, 1 IS NOT NULL
----
NULL NULL t t

query TTTTTT
SELECT true AND NULL, false AND NULL, true OR NULL, false OR NULL, NOT NULL::bool, NOT true
----
NULL f t NULL NULL f

query TTT
SELECT 1 IS DISTINCT FROM NULL, NULL IS DISTINCT FROM NULL, 1 IS NOT DISTINCT FROM 1
----
t f t

query TTT
SELECT 5 BETWEEN 1 AND 10, 5 NOT BETWEEN 6 AND 10, NULL BETWEEN 1 AND 2
----
t t NULL

query TTTT
SELECT 2 IN (1, 2, 3), 4 IN (1, 2, 3), 4 IN (1, NULL), 4 NOT IN (1, NULL)
----
t f NULL NULL

query TT
SELECT CASE WHEN 1 > 2 THEN 'a' WHEN 1 < 2 THEN 'b' ELSE 'c' END, CASE 2 WHEN 1 THEN 'one' WHEN 2 THEN 'two' END
----
b two

query T
SELECT CASE WHEN false THEN 'x' END
----
NULL

query IIT
SELECT coalesce(NULL, 2), coalesce(1, 2), coalesce(NULL::text, NULL)
----
2 1 NULL

query IIII
SELECT nullif(1, 1), nullif(1, 2), greatest(1, 3, 2), least(4, NULL, 2)
----
NULL 1 3 2

query TTTT
SELECT 'a' || 'b', 'a' || 1, upper('abc'), lower('ABC')
----
ab a1 ABC abc

query III
SELECT length('hello'), position('l' in 'hello'), char_length('')
----
5 3 0

query TTT
SELECT substring('hello' from 2 for 3), substr('hello', 2), trim('  x  ')
----
ell ello x

query TTT
SELECT replace('aXbX', 'X', '-'), repeat('ab', 3), reverse('abc')
----
a-b- ababab cba

query TTTT
SELECT 'abc' LIKE 'a%', 'abc' LIKE '_b_', 'abc' NOT LIKE 'b%', 'ABC' ILIKE 'abc'
----
t t t t

query TT
SELECT 'abc' ~ '^a', 'abc' ~ 'x'
----
t f

query III
SELECT '42'::int, 3.7::int, -3.5::int
----
42 4 -4

query TTT
SELECT 42::text, true::text, 1.50::text
----
42 true 1.50

query RR
SELECT '3.14'::numeric, 1::numeric / 3
----
3.140 0.333

query TT
SELECT 1::bool, 'no'::bool
----
t f

query I
SELECT abs(-5) + sign(-3) + mod(7, 4)
----
7

query RRRR
SELECT round(2.567, 2), ceil(1.2), floor(-1.2), trunc(1.99)
----
2.570 2.000 -2.000 1.000

query RR
SELECT sqrt(16), power(2, 10)
----
4.000 1024.000

query error (22012)
SELECT 1 / 0

query error (22P02)
SELECT 'x'::int

query error (22003)
SELECT 2147483647 + 1

query error (22003)
SELECT 9223372036854775807 + 1

query error (42703)
SELECT nosuch

query error (42883)
SELECT nosuch(1)

query error (42601)
SELECT 1 +

query error (22P02)
SELECT 1 + 'a'

query error (42883)
SELECT 1 || 2

query error (42804)
SELECT 1 WHERE 1

query error (42883)
SELECT true + 1

query TT
SELECT date '2024-02-28' + 2, date '2024-03-01' - date '2024-02-01'
----
2024-03-01 29

query TT
SELECT timestamp '2024-01-01 10:00:00' + interval '1 day 2 hours', date_trunc('month', timestamp '2024-05-17 13:00:00')
----
2024-01-02 12:00:00 2024-05-01 00:00:00

query II
SELECT extract(year FROM date '2024-05-17')::int, extract(dow FROM date '2024-05-17')::int
----
2024 5

query TTT
SELECT (1, 2) = (1, 2), (1, 2) < (1, 3), (1, NULL) = (1, NULL)
----
t t NULL

query T
SELECT ARRAY[1, 2, 3]
----
{1,2,3}

query IIT
SELECT (ARRAY[10, 20])[2], array_length(ARRAY[1, 2, 3], 1), 2 = ANY (ARRAY[1, 2])
----
20 3 t

query TT
SELECT 3 > ALL (ARRAY[1, 2]), 3 > ANY (ARRAY[5, 6])
----
t f

query I rowsort
SELECT * FROM generate_series(1, 5)
----
1
2
3
4
5

query I
SELECT count(*) FROM generate_series(1, 100) g WHERE g % 7 = 0
----
14

query IT
SELECT * FROM (VALUES (1, 'a'), (2, 'b')) v (n, s) ORDER BY n DESC
----
2 b
1 a

query I
VALUES (3), (1), (2) ORDER BY 1
----
1
2
3
