2 1 1
3 1 2
4 2 2
5 2 3
6 2 4

query IRR
SELECT id, percent_rank() OVER (ORDER BY v), cume_dist() OVER (ORDER BY v) FROM w WHERE v IS NOT NULL ORDER BY v, id
----
4 0.000 0.200
6 0.250 0.400
1 0.500 0.600
2 0.750 1.000
3 0.750 1.000

query III
SELECT id, sum(v) OVER win, count(*) OVER win FROM w WINDOW win AS (PARTITION BY g ORDER BY id) ORDER BY id
----
1 10 1
2 30 2
3 50 3
4 5 1
5 5 2
6 7 1

query TII
SELECT g, sum(v), rank() OVER (ORDER BY sum(v) DESC NULLS LAST) FROM w GROUP BY g ORDER BY g
----
a 50 1
b 5 3
c 7 2

query TII
SELECT g, sum(v), sum(sum(v)) OVER () FROM w GROUP BY g ORDER BY g
----
a 50 62
b 5 62
c 7 62

query II
SELECT id, rn FROM (SELECT id, row_number() OVER (PARTITION BY g ORDER BY v DESC NULLS LAST) AS rn FROM w) s WHERE rn = 1 ORDER BY id
----
2 1
4 1
6 1

