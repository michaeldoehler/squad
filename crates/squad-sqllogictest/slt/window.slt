# Window functions.

statement ok
CREATE TABLE w (id int PRIMARY KEY, g text, v int)

statement ok
INSERT INTO w VALUES (1, 'a', 10), (2, 'a', 20), (3, 'a', 20), (4, 'b', 5), (5, 'b', NULL), (6, 'c', 7)

query III
SELECT id, row_number() OVER (ORDER BY id), count(*) OVER () FROM w ORDER BY id
----
1 1 6
2 2 6
3 3 6
4 4 6
5 5 6
6 6 6

query ITI
SELECT id, g, row_number() OVER (PARTITION BY g ORDER BY id) FROM w ORDER BY id
----
1 a 1
2 a 2
3 a 3
4 b 1
5 b 2
6 c 1

query IIII
SELECT id, v, rank() OVER (ORDER BY v), dense_rank() OVER (ORDER BY v) FROM w ORDER BY v NULLS LAST, id
----
4 5 1 1
6 7 2 2
1 10 3 3
2 20 4 4
3 20 4 4
5 NULL 6 5

query II
SELECT id, rank() OVER (PARTITION BY g ORDER BY v DESC NULLS LAST) FROM w ORDER BY id
----
1 3
2 1
3 1
4 1
5 2
6 1

query IIR
SELECT id, sum(v) OVER (PARTITION BY g), avg(v) OVER (PARTITION BY g) FROM w ORDER BY id
----
1 50 16.667
2 50 16.667
3 50 16.667
4 5 5.000
5 5 5.000
6 7 7.000

