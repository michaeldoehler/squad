3 3

query IIII
SELECT id, lag(v) OVER (ORDER BY id), lead(v) OVER (ORDER BY id), lag(v, 2, -1) OVER (ORDER BY id) FROM w ORDER BY id
----
1 NULL 20 -1
2 10 20 -1
3 20 5 10
4 20 NULL 20
5 5 7 20
6 NULL NULL 5

query IIII
SELECT id, first_value(v) OVER (PARTITION BY g ORDER BY id), last_value(v) OVER (PARTITION BY g ORDER BY id), nth_value(v, 2) OVER (PARTITION BY g ORDER BY id) FROM w ORDER BY id
----
1 10 10 NULL
2 10 20 20
3 10 20 20
4 5 5 NULL
5 5 NULL NULL
6 7 7 NULL

query III
SELECT id, ntile(2) OVER (ORDER BY id), ntile(4) OVER (ORDER BY id) FROM w ORDER BY id
----
