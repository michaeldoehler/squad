# Tables, constraints, INSERT / UPDATE / DELETE.

statement ok
CREATE TABLE person (id int PRIMARY KEY, name text NOT NULL, age int CHECK (age >= 0), email text UNIQUE, city text DEFAULT 'Berlin')

statement ok
INSERT INTO person VALUES (1, 'Ada', 36, 'ada@example.org', 'London')

statement ok
INSERT INTO person (id, name, age) VALUES (2, 'Bob', 25), (3, 'Cy', 51), (4, 'Dee', NULL)

statement ok
INSERT INTO person (id, name, email) VALUES (5, 'Eve', 'eve@example.org')

query ITITT
SELECT * FROM person ORDER BY id
----
1 Ada 36 ada@example.org London
2 Bob 25 NULL Berlin
3 Cy 51 NULL Berlin
4 Dee NULL NULL Berlin
5 Eve NULL eve@example.org Berlin

query I
SELECT count(*) FROM person
----
5

