statement error (23503)
INSERT INTO order_line VALUES (9, 1, 'orphan')

statement error (23503)
DELETE FROM item WHERE id = 1

statement ok
DELETE FROM orders WHERE id = 1

query IIT
SELECT * FROM order_line ORDER BY 1, 2
----
2 1 z

statement error (23503)
UPDATE orders SET item_id = 999 WHERE id = 2

