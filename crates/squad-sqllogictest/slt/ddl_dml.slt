# Defaults, serial columns and multi-row inserts from a query.

statement ok
CREATE TABLE item (id serial PRIMARY KEY, label text DEFAULT 'none', qty int NOT NULL DEFAULT 1, price numeric(8,2))

statement ok
INSERT INTO item DEFAULT VALUES

statement ok
INSERT INTO item (label, price) VALUES ('a', 1.5), ('b', 2.25), ('c', NULL)

statement ok
INSERT INTO item (label, qty, price) SELECT label || '2', qty + 1, price * 2 FROM item WHERE price IS NOT NULL

query ITIR
SELECT * FROM item ORDER BY id
----
1 none 1 NULL
2 a 1 1.500
3 b 1 2.250
4 c 1 NULL
5 a2 2 3.000
6 b2 2 4.500

statement error (23502)
INSERT INTO item (qty) VALUES (NULL)

statement ok
INSERT INTO item (label, qty) VALUES (DEFAULT, DEFAULT)

query I
SELECT max(id) FROM item
----
8

# Composite keys and foreign keys.

statement ok
CREATE TABLE orders (id int PRIMARY KEY, item_id int NOT NULL REFERENCES item (id), n int)

statement ok
CREATE TABLE order_line (order_id int REFERENCES orders (id) ON DELETE CASCADE, line int, note text, PRIMARY KEY (order_id, line))

statement ok
INSERT INTO orders VALUES (1, 1, 5), (2, 2, 7)

statement error (23503)
INSERT INTO orders VALUES (3, 999, 1)

statement ok
INSERT INTO order_line VALUES (1, 1, 'x'), (1, 2, 'y'), (2, 1, 'z')

statement error (23505)
