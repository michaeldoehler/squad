# Filtering, ordering, limits, DISTINCT and set operations.

statement ok
CREATE TABLE t (a int PRIMARY KEY, b int, c text)

statement ok
INSERT INTO t VALUES (1, 10, 'x'), (2, 20, 'y'), (3, 10, 'z'), (4, NULL, 'x'), (5, 30, NULL), (6, 20, 'y')

query IIT
SELECT * FROM t ORDER BY a
----
1 10 x
2 20 y
3 10 z
4 NULL x
5 30 NULL
6 20 y

query I
SELECT a FROM t WHERE b = 10 ORDER BY a
----
1
3

query I
SELECT a FROM t WHERE b <> 10 ORDER BY a
----
2
5
6

query I
SELECT a FROM t WHERE b IS NULL
----
4

query I
SELECT a FROM t WHERE b > 10 AND c = 'y' ORDER BY a
----
2
6

query I
SELECT a FROM t WHERE b > 20 OR c = 'x' ORDER BY a
----
1
4
5

query I
SELECT a FROM t WHERE NOT (b > 10) ORDER BY a
----
