# INSERT ... ON CONFLICT and RETURNING.

statement ok
CREATE TABLE kv (k text PRIMARY KEY, v int NOT NULL, hits int NOT NULL DEFAULT 0, tag text UNIQUE)

query TII
INSERT INTO kv (k, v) VALUES ('a', 1), ('b', 2) RETURNING k, v, hits
----
a 1 0
b 2 0

query TIIT
INSERT INTO kv (k, v, tag) VALUES ('c', 3, 't1') RETURNING *
----
c 3 0 t1

query TI
INSERT INTO kv (k, v) VALUES ('d', 4) RETURNING upper(k) AS key, v * 10
----
D 40

statement error (23505)
INSERT INTO kv (k, v) VALUES ('a', 100)

statement ok
INSERT INTO kv (k, v) VALUES ('a', 100) ON CONFLICT DO NOTHING

statement ok
INSERT INTO kv (k, v) VALUES ('a', 100) ON CONFLICT (k) DO NOTHING

query TI
INSERT INTO kv (k, v) VALUES ('a', 100), ('e', 5) ON CONFLICT (k) DO NOTHING RETURNING k, v
----
e 5

query TII
INSERT INTO kv (k, v) VALUES ('a', 100) ON CONFLICT (k) DO UPDATE SET v = excluded.v, hits = kv.hits + 1 RETURNING k, v, hits
----
a 100 1

query TII
INSERT INTO kv (k, v) VALUES ('a', 7), ('f', 6) ON CONFLICT (k) DO UPDATE SET v = kv.v + excluded.v, hits = kv.hits + 1 RETURNING k, v, hits
----
a 107 2
f 6 0

query TI
INSERT INTO kv (k, v) VALUES ('b', 50) ON CONFLICT (k) DO UPDATE SET v = excluded.v WHERE kv.v > 10 RETURNING k, v
----

query TI
INSERT INTO kv (k, v) VALUES ('b', 50) ON CONFLICT (k) DO UPDATE SET v = excluded.v WHERE kv.v < 10 RETURNING k, v
----
b 50

