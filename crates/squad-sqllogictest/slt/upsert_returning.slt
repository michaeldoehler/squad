statement ok
CREATE TABLE counter (id int PRIMARY KEY, n int)

statement ok
INSERT INTO counter VALUES (1, 0)

statement ok
INSERT INTO counter VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET n = counter.n + 1

statement ok
INSERT INTO counter VALUES (1, 1) ON CONFLICT (id) DO UPDATE SET n = counter.n + 1

query II
SELECT * FROM counter
----
1 2

query II rowsort
INSERT INTO counter SELECT g, g FROM generate_series(1, 3) g ON CONFLICT (id) DO UPDATE SET n = counter.n + excluded.n RETURNING id, n
----
1 3
2 2
3 3

query II
SELECT * FROM counter ORDER BY id
----
1 3
2 2
3 3
