query IIIIII
SELECT c1.a, c2.a, c3.a, c4.a, c5.a, c6.a FROM c1, c4, c2, c6, c3, c5 WHERE c5.a = c4.b AND c2.a = c1.b AND c6.a = c5.b AND c3.a = c2.b AND c4.a = c3.b AND c1.a = 7
----
7 8 57 72 93 10

query I
SELECT count(*) FROM c6, c1, c5, c2, c4, c3 WHERE c1.b = c2.a AND c2.b = c3.a AND c3.b = c4.a AND c4.b = c5.a AND c5.b = c6.a
----
300

query II
SELECT count(*), sum(c3.b) FROM c1, c2, c3 WHERE c3.a = c1.b AND c2.a < 3 AND c1.a <= 10
----
20 410

query III rowsort
SELECT x.a, y.a, z.a FROM c1 x, c2 y, c3 z WHERE x.a = z.b AND y.a = z.a AND z.a < 4
----
10 3 3
4 1 1
7 2 2

query I
SELECT count(*) FROM c1 JOIN c2 ON true JOIN c3 ON c3.a = c1.b AND c3.b = c2.a WHERE c1.a < 50
----
49
