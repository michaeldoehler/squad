WITH RECURSIVE sub AS (SELECT id, name, 0 AS depth FROM tree WHERE id = 2 UNION ALL SELECT t.id, t.name, sub.depth + 1 FROM tree t JOIN sub ON t.parent = sub.id) SELECT * FROM sub ORDER BY depth, id;
