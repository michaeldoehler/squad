-- Joins of all kinds.
CREATE TABLE dept (id int PRIMARY KEY, name text NOT NULL);
CREATE TABLE emp (id int PRIMARY KEY, name text NOT NULL, dept_id int, salary numeric(10,2), manager_id int);
CREATE INDEX emp_dept_idx ON emp (dept_id);
INSERT INTO dept VALUES (1, 'eng'), (2, 'ops'), (3, 'empty');
INSERT INTO emp VALUES (1, 'ann', 1, 100.00, NULL), (2, 'bob', 1, 80.50, 1), (3, 'cat', 2, 70.00, 1), (4, 'dan', NULL, 60.00, 3), (5, 'eve', 2, 90.25, 3);
SELECT e.name, d.name FROM emp e JOIN dept d ON d.id = e.dept_id ORDER BY e.id;
name|name
ann|eng
bob|eng
cat|ops
eve|ops
(4 rows)
