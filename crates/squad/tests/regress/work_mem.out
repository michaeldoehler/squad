-- work_mem: the setting, and queries whose sorts, hash tables and window
-- partitions exceed it, over data with NULLs, duplicates and many types.
SHOW work_mem;
work_mem
4MB
(1 row)
SET work_mem = '64kB';
SHOW work_mem;
work_mem
64kB
(1 row)
SET work_mem = 2048;
SHOW work_mem;
work_mem
