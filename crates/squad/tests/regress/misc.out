2
(2 rows)
SELECT id FROM base ORDER BY id LIMIT 2 OFFSET 1;
id
2
3
(2 rows)
SELECT id FROM base ORDER BY id OFFSET 3;
id
4
10
(2 rows)
SELECT id FROM base ORDER BY id DESC LIMIT 1;
id
10
(1 row)
SELECT id FROM base ORDER BY kind DESC, n DESC;
id
10
4
2
3
1
(5 rows)
SELECT id, kind FROM base ORDER BY 2, 1 DESC;
id|kind
