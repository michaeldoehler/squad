-- Sequences, views, prepared statements and other odds and ends.
CREATE SEQUENCE s1;
SELECT nextval('s1'), nextval('s1'), currval('s1');
nextval|nextval|currval
1|2|2
(1 row)
CREATE SEQUENCE s2 START 10 INCREMENT 5;
SELECT nextval('s2'), nextval('s2');
nextval|nextval
10|15
(1 row)
SELECT setval('s2', 100), nextval('s2');
setval|nextval
100|105
(1 row)
SELECT setval('s2', 1, false), nextval('s2');
setval|nextval
1|1
(1 row)
CREATE SEQUENCE s3 MAXVALUE 2;
SELECT nextval('s3'), nextval('s3');
nextval|nextval
1|2
(1 row)
SELECT nextval('s3');
ERROR:  2200H
SELECT nextval('nosuch');
ERROR:  42P01
SELECT currval('s3'), lastval();
currval|lastval
2|2
(1 row)
ALTER SEQUENCE s1 RESTART WITH 50;
SELECT nextval('s1');
nextval
50
(1 row)
DROP SEQUENCE s3;
SELECT nextval('s3');
ERROR:  42P01
CREATE TABLE gen (id int GENERATED ALWAYS AS IDENTITY PRIMARY KEY, id2 bigint GENERATED BY DEFAULT AS IDENTITY, v text);
INSERT INTO gen (v) VALUES ('a'), ('b');
INSERT INTO gen (id2, v) VALUES (100, 'c');
INSERT INTO gen (id, v) VALUES (9, 'd');
ERROR:  428C9
INSERT INTO gen (id, v) OVERRIDING SYSTEM VALUE VALUES (9, 'd');
SELECT * FROM gen ORDER BY id;
id|id2|v
1|1|a
2|2|b
3|100|c
9|3|d
(4 rows)
-- views
CREATE TABLE base (id int PRIMARY KEY, kind text, n int);
INSERT INTO base VALUES (1, 'a', 10), (2, 'b', 20), (3, 'a', 30);
CREATE VIEW v_a AS SELECT id, n FROM base WHERE kind = 'a';
SELECT * FROM v_a ORDER BY id;
id|n
1|10
3|30
(2 rows)
CREATE VIEW v_sum (kind, total) AS SELECT kind, sum(n) FROM base GROUP BY kind;
SELECT * FROM v_sum ORDER BY kind;
kind|total
a|40
b|20
(2 rows)
SELECT v_a.id, v_sum.total FROM v_a JOIN base b ON b.id = v_a.id JOIN v_sum ON v_sum.kind = b.kind ORDER BY 1;
id|total
1|40
3|40
(2 rows)
CREATE VIEW v_a AS SELECT 1;
ERROR:  42P07
CREATE OR REPLACE VIEW v_a AS SELECT id, n FROM base WHERE kind = 'b';
SELECT * FROM v_a;
id|n
2|20
(1 row)
INSERT INTO base VALUES (4, 'b', 40);
SELECT count(*) FROM v_a;
count
2
(1 row)
DROP VIEW v_sum;
SELECT * FROM v_sum;
ERROR:  42P01
DROP VIEW nosuch;
ERROR:  42P01
CREATE VIEW bad AS SELECT * FROM nosuch;
ERROR:  42P01
-- prepared statements
PREPARE p1 (int) AS SELECT id, kind FROM base WHERE id = $1;
EXECUTE p1 (1);
id|kind
1|a
(1 row)
EXECUTE p1 (3);
id|kind
3|a
(1 row)
PREPARE p2 AS INSERT INTO base VALUES ($1, $2, $3) RETURNING id;
EXECUTE p2 (10, 'z', 1);
id
10
(1 row)
EXECUTE p1 (10);
id|kind
10|z
(1 row)
EXECUTE p1;
ERROR:  42601
EXECUTE nosuch (1);
ERROR:  26000
PREPARE p1 AS SELECT 1;
ERROR:  42P05
DEALLOCATE p1;
EXECUTE p1 (1);
ERROR:  26000
-- limit, offset, ordering
SELECT id FROM base ORDER BY id LIMIT 2;
id
