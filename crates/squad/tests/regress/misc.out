-- generate_series and other set-returning functions
SELECT * FROM generate_series(1, 5) AS g WHERE g % 2 = 1;
g
1
3
5
(3 rows)
SELECT generate_series(1, 3) * 10 AS x;
x
10
20
30
(3 rows)
SELECT g, g * g FROM generate_series(3, 1, -1) g;
g|?column?
