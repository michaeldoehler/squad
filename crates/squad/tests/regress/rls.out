SET app.tenant = 'acme';
-- prepared statements read the setting when they run
PREPARE visible AS SELECT id FROM docs ORDER BY id;
PREPARE by_id(int) AS SELECT body FROM docs WHERE id = $1;
EXECUTE visible;
