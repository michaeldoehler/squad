-- Custom settings (names with a dot), SET LOCAL, set_config and
-- current_setting, and how transactions undo setting changes.
SHOW app.tenant;
ERROR:  42704
SELECT current_setting('app.tenant');
ERROR:  42704
SELECT current_setting('app.tenant', true) IS NULL AS unset;
unset
t
(1 row)
SET app.tenant = 'acme';
SHOW app.tenant;
app.tenant
acme
(1 row)
SELECT current_setting('app.tenant'), current_setting('app.tenant', false);
current_setting|current_setting
acme|acme
(1 row)
SET app.tenant TO 'globex';
SHOW app.tenant;
app.tenant
globex
(1 row)
-- reset keeps the setting, empty
RESET app.tenant;
SHOW app.tenant;
app.tenant

(1 row)
SELECT current_setting('app.tenant', true) IS NULL AS unset, current_setting('app.tenant') = '' AS empty;
unset|empty
f|t
(1 row)
SET app.tenant TO DEFAULT;
SHOW app.tenant;
app.tenant

(1 row)
SET app.count = 42;
SHOW app.count;
app.count
42
(1 row)
SET app.flag = on;
SHOW app.flag;
app.flag
on
(1 row)
SET app.list = 'a', 'b';
ERROR:  22023
SET SESSION app.tenant = 'acme';
SHOW app.tenant;
app.tenant
acme
(1 row)
-- names without a dot are not custom settings
SELECT current_setting('no_such_setting');
ERROR:  42704
SELECT current_setting('no_such_setting', true);
current_setting
NULL
(1 row)
SELECT current_setting('app.never.set', true);
current_setting
NULL
(1 row)
SELECT current_setting(NULL);
current_setting
NULL
(1 row)
-- SET in a transaction that rolls back is undone
BEGIN;
SET app.tenant = 'initech';
SHOW app.tenant;
app.tenant
initech
(1 row)
ROLLBACK;
SHOW app.tenant;
app.tenant
acme
(1 row)
BEGIN;
SET app.tenant = 'initech';
COMMIT;
SHOW app.tenant;
app.tenant
initech
(1 row)
-- SET LOCAL lasts until the transaction ends
BEGIN;
SET LOCAL app.tenant = 'local';
SHOW app.tenant;
app.tenant
local
(1 row)
SELECT current_setting('app.tenant');
current_setting
local
(1 row)
COMMIT;
SHOW app.tenant;
app.tenant
initech
(1 row)
BEGIN;
SET LOCAL app.tenant = 'local';
ROLLBACK;
SHOW app.tenant;
app.tenant
initech
(1 row)
BEGIN;
SET app.tenant = 'session';
SET LOCAL app.tenant = 'local';
SHOW app.tenant;
app.tenant
local
(1 row)
COMMIT;
SHOW app.tenant;
app.tenant
session
(1 row)
BEGIN;
SET LOCAL app.tenant = 'local';
SET app.tenant = 'session2';
SHOW app.tenant;
app.tenant
session2
(1 row)
COMMIT;
SHOW app.tenant;
app.tenant
session2
(1 row)
-- SET LOCAL outside a transaction block has no effect
SET LOCAL app.tenant = 'ignored';
SHOW app.tenant;
app.tenant
session2
(1 row)
SET LOCAL app.other = 'ignored';
SHOW app.other;
app.other

(1 row)
-- savepoints
BEGIN;
SET app.tenant = 't1';
SAVEPOINT a;
SET app.tenant = 't2';
SHOW app.tenant;
app.tenant
t2
(1 row)
ROLLBACK TO SAVEPOINT a;
SHOW app.tenant;
app.tenant
t1
(1 row)
SAVEPOINT b;
SET LOCAL app.tenant = 't3';
RELEASE SAVEPOINT b;
SHOW app.tenant;
app.tenant
t3
(1 row)
COMMIT;
SHOW app.tenant;
app.tenant
t1
(1 row)
BEGIN;
SAVEPOINT a;
SET app.tenant = 't4';
ROLLBACK TO a;
SHOW app.tenant;
app.tenant
t1
(1 row)
SET app.tenant = 't5';
COMMIT;
SHOW app.tenant;
app.tenant
t5
(1 row)
-- an error aborts the transaction; its settings are undone
BEGIN;
SET app.tenant = 'doomed';
SELECT 1 / 0;
ERROR:  22012
COMMIT;
SHOW app.tenant;
app.tenant
t5
(1 row)
