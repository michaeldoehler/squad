(1 row)
-- a failing statement undoes its set_config
SELECT set_config('app.tenant', 'failed', false), 1 / 0;
ERROR:  22012
SHOW app.tenant;
app.tenant
acme
(1 row)
-- the same setting in WHERE clauses and with parameters
CREATE TABLE docs (id int PRIMARY KEY, tenant text NOT NULL);
INSERT INTO docs VALUES (1, 'acme'), (2, 'globex'), (3, 'acme');
SELECT id FROM docs WHERE tenant = current_setting('app.tenant') ORDER BY id;
id
1
3
(2 rows)
SET app.tenant = 'globex';
SELECT id FROM docs WHERE tenant = current_setting('app.tenant') ORDER BY id;
id
2
(1 row)
PREPARE by_tenant AS SELECT id FROM docs WHERE tenant = current_setting('app.tenant', true) ORDER BY id;
EXECUTE by_tenant;
id
2
(1 row)
SET app.tenant = 'acme';
EXECUTE by_tenant;
id
1
3
(2 rows)
RESET app.tenant;
EXECUTE by_tenant;
id
(0 rows)
