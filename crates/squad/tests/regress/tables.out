-- Tables, constraints and DML.
CREATE TABLE users (
    id bigint PRIMARY KEY,
    email text NOT NULL UNIQUE,
    name varchar(20),
    age int CHECK (age >= 0),
    active boolean NOT NULL DEFAULT true,
    created timestamp DEFAULT '2024-01-01 00:00:00'
);
INSERT INTO users (id, email, name, age) VALUES (1, 'ada@example.org', 'Ada', 36), (2, 'bob@example.org', 'Bob', 25);
INSERT INTO users (id, email) VALUES (3, 'cy@example.org') RETURNING *;
id|email|name|age|active|created
3|cy@example.org|NULL|NULL|t|2024-01-01 00:00:00
(1 row)
SELECT * FROM users ORDER BY id;
id|email|name|age|active|created
1|ada@example.org|Ada|36|t|2024-01-01 00:00:00
2|bob@example.org|Bob|25|t|2024-01-01 00:00:00
3|cy@example.org|NULL|NULL|t|2024-01-01 00:00:00
(3 rows)
SELECT id, name FROM users WHERE age > 30;
id|name
1|Ada
(1 row)
SELECT count(*), count(age), sum(age), avg(age), min(name), max(name) FROM users;
count|count|sum|avg|min|max
3|2|61|30.5000000000000000|Ada|Bob
(1 row)
