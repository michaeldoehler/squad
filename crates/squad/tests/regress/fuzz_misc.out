SELECT CASE WHEN id > 1 THEN 'x' ELSE s END, CASE WHEN id > 1 THEN 1 ELSE length(s) END, CASE WHEN id > 1 THEN 1 ELSE id::bigint END, CASE WHEN id > 1 THEN 1 ELSE 2 END, CASE WHEN id > 1 THEN 1 END FROM f WHERE false;
