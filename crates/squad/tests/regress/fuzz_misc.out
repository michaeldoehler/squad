-- UPDATE reports the first failing row's error
CREATE TABLE u (id int PRIMARY KEY, a int NOT NULL, b smallint);
INSERT INTO u VALUES (1, 1, 1), (2, 100000, 2);
UPDATE u SET a = NULL, b = a;
ERROR:  23502
UPDATE u SET b = a WHERE id = 2;
