b|5|62
c|7|62
(3 rows)
SELECT * FROM (SELECT id, row_number() OVER (PARTITION BY grp ORDER BY v DESC NULLS LAST) AS rn FROM w) s WHERE rn = 1 ORDER BY id;
id|rn
2|1
4|1
6|1
(3 rows)
SELECT id, string_agg(grp, '') OVER (ORDER BY id) FROM w ORDER BY id;
id|string_agg
1|a
2|aa
